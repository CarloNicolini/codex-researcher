#!/bin/bash

set -Eeuo pipefail
IFS=$'\n\t'

# ==============================================================================
# CODEX RESEARCHER - Autonomous Research Paper Pipeline
# Refines a Markdown file into a professional research paper using Codex CLI.
# ==============================================================================

VERSION="2.3.0"
BACKUP_DIR=".research_backups"

# Defaults
TARGET_FILE="project.md"
INSTRUCTION_FILE=""
GOAL=""
MAX_ITERATIONS=10
ITERATION_DELAY=2
DRY_RUN=false
MODEL_FLAG="" 
NO_CHANGE_THRESHOLD=2
MAX_DURATION=""
MAX_COST=""
PRICE_PER_1K=""
SANDBOX_MODE="workspace-write"
APPROVAL_POLICY="on-failure"

SUCCESSFUL_ITERATIONS=0
ERROR_STREAK=0
TOTAL_TOKENS=0
TOTAL_COST="0"

NOTES_FILE="shared_task_notes.md"
ENABLE_COMMITS=true
GIT_BRANCH_PREFIX="researcher/"
MERGE_STRATEGY="squash"
GITHUB_OWNER=""
GITHUB_REPO=""
WORKTREE_NAME=""
WORKTREE_BASE_DIR="../researcher-worktrees"
CLEANUP_WORKTREE=false
LIST_WORKTREES=false
MAIN_BRANCH=""

# ------------------------------------------------------------------------------
# PROMPTS & PERSONAS
# ------------------------------------------------------------------------------

# The Core Persona
SYSTEM_CONTEXT="You are a Senior Principal Researcher at a top-tier institute. 
Your goal is to transform the project rooted at '{TARGET_FILE}' into a rigorous research paper.
- Strictly use LaTeX for math (e.g., $\int f(x) dx$).
- Use standard Markdown headers.
- NO conversational filler. DO NOT say 'Here is the code'.
- The project may be a single Markdown file or a directory of numbered Markdown section files (e.g., 1_abstract.md, 2_introduction.md, ...).
- EDIT only the files under '{TARGET_FILE}' (create/update numbered section files when appropriate). Do not write back into a single large monolithic file.
- Always persist your edits by writing to the Markdown files on disk using shell commands; do not just print revised content to stdout.
- Never modify files outside the project root. Do not run package managers or system-level commands; limit shell usage to viewing and editing project files.
- Maintain a concise status/notes file 'shared_task_notes.md' across iterations as instructed.
- Do not output file contents to stdout unless requested.
- When reviewing any section file, read and reason about its entire contents (not only the first few lines), even if the file is long; ensure edits remain globally consistent with the whole document.
- Avoid excessive markdown structure; prefer fluent textbook or research-paper English prose instead of many bullet points."

PROMPT_INIT="Generate a comprehensive outline and write the initial Abstract and Introduction based on the goal. Ensure standard academic structure."
PROMPT_EXPANSION="Review the target file. Identify sections that are brief. Expand them with theoretical context and simulated citations. Identify and draft new sections that can make the paper better, correlated applications or further developments."
PROMPT_MATHEMATIZE="Review the target file. Convert plain text logic into rigorous mathematical notation, formal definitions, and proofs."
PROMPT_CRITIQUE="Act as 'Reviewer #2'. Harshly critique logic/flow in the target file. Remove redundancy and fix weak arguments."
PROMPT_POLISH="Final Polish. Check for academic tone, consistency, and formatting. Ensure structure: Abstract, Intro, Related Work, Methodology, Results, Conclusion."

