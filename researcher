#!/bin/bash

set -Eeuo pipefail
IFS=$'\n\t'

VERSION="2.4.0"
TARGET_FILE="project.md"
INSTRUCTION_FILE=""
GOAL=""
ITERATIONS=6
DELAY=2
DRY_RUN=false
MODEL_FLAG=""
SANDBOX_MODE="workspace-write"
APPROVAL_POLICY="on-failure"
NOTES_FILE="shared_task_notes.md"
PROJECT_TYPE="markdown"
LATEX_MAIN=""
LATEX_FILES=()
LATEX_SEEN=""
PATH_RESOLVER=""

PROMPT_INIT="Generate a comprehensive outline and write the initial Abstract and Introduction based on the goal. Ensure standard academic structure."
PROMPT_EXPANSION="Review the target file. Identify sections that are brief. Expand them with theoretical context and simulated citations. Identify and draft new sections that can make the paper better, correlated applications or further developments."
PROMPT_MATHEMATIZE="Review the target file. Convert plain text logic into rigorous mathematical notation, formal definitions, and proofs."
PROMPT_CRITIQUE="Act as 'Reviewer #2'. Harshly critique logic/flow in the target file. Remove redundancy and fix weak arguments."
PROMPT_POLISH="Final Polish. Check for academic tone, consistency, and formatting. Ensure structure: Abstract, Intro, Related Work, Methodology, Results, Conclusion."

PROMPT_INIT_OVERRIDE=""
PROMPT_EXPANSION_OVERRIDE=""
PROMPT_MATHEMATIZE_OVERRIDE=""
PROMPT_CRITIQUE_OVERRIDE=""
PROMPT_POLISH_OVERRIDE=""

SYSTEM_CONTEXT="You are a Senior Principal Researcher at a top-tier institute.\nYour goal is to transform the project rooted at '{TARGET_FILE}' into a rigorous research paper.\n- Strictly use LaTeX for math (e.g., $\\int f(x) dx$).\n- Use standard Markdown headers.\n- NO conversational filler. DO NOT say 'Here is the code'.\n- Maintain a concise status/notes file 'shared_task_notes.md' across iterations as instructed.\n- Do not output file contents to stdout unless requested.\n- When reviewing any section file, read and reason about its entire contents.\n- When working on a LaTeX project, inspect the main file's \\input/\\include graph and edit each referenced .tex file in place.\n- Avoid excessive markdown structure and prefer fluent textbook or research-paper English prose."

log_info() { printf '[INFO] %s\n' "$1"; }
log_warn() { printf '[WARN] %s\n' "$1"; }
log_err() { printf '[ERROR] %s\n' "$1"; }
log_success() { printf '[SUCCESS] %s\n' "$1"; }

detect_path_resolver() {
    if command -v python3 >/dev/null 2>&1; then
        PATH_RESOLVER="python3"
    elif command -v python >/dev/null 2>&1; then
        PATH_RESOLVER="python"
    elif command -v perl >/dev/null 2>&1; then
        PATH_RESOLVER="perl"
    else
        PATH_RESOLVER=""
    fi
}

normalize_path() {
    local target="$1"
    if [ -z "$target" ]; then
        printf ''
        return
    fi
    case "$PATH_RESOLVER" in
        python3|python)
            "$PATH_RESOLVER" - "$target" <<'PY'
import os, sys
print(os.path.normpath(os.path.abspath(sys.argv[1])))
PY
            ;;
        perl)
            perl -MCwd -e 'print Cwd::abs_path($ARGV[0])' "$target"
            ;;
        *)
            printf '%s' "$target"
            ;;
    esac
}

detect_path_resolver

split_markdown_into_sections() {
    local source_file="$1"
    local dest_dir="$2"

    if [ ! -f "$source_file" ]; then
        return 1
    fi

    mkdir -p "$dest_dir"

    awk -v outdir="$dest_dir" '\n    function open_section(raw_title) {\n        section++\n        slug = raw_title\n        gsub(/^[#[:space:]]+/, "", slug)\n        gsub(/[^A-Za-z0-9]+/, "_", slug)\n        gsub(/^_+|_+$/, "", slug)\n        if (slug == "") slug = "section"\n        filename = sprintf("%s/%d_%s.md", outdir, section, tolower(slug))\n        close(current)\n        current = filename\n        print "" > current\n    }\n    BEGIN { section = 0; current = "" }\n    {\n        if ($0 ~ /^# /) {\n            open_section($0)\n        } else if (section == 0) {\n            open_section("section")\n        }\n        print $0 >> current\n    }\n    END {\n        if (section == 0) {\n            current = sprintf("%s/1_section.md", outdir)\n            print "" > current\n        }\n    }\n    ' "$source_file"
}

collect_latex_files() {
    local file="$1"
    if [ -z "$file" ]; then
        return 0
    fi
    if printf '%s\n' "$LATEX_SEEN" | grep -Fxq "$file"; then
        return 0
    fi
    LATEX_SEEN="${LATEX_SEEN}${file}"$'\n'
    LATEX_FILES+=("$file")

    local dir
    dir=$(dirname "$file")
    local matches
    matches=$(perl -ne 's/%.*//; while (/(?:\\input|\\include)\s*\{([^}]+)\}/g) {print "$1\n"}' "$file")

    local relpath
    while IFS= read -r relpath; do
        relpath=$(printf '%s' "$relpath" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -z "$relpath" ]; then
            continue
        fi

        local candidate="$relpath"
        local base
        base=$(basename "$candidate")
        local ext=""
        if [[ "$base" == *.* ]]; then
            ext="${base##*.}"
        fi
        if [ -z "$ext" ]; then
            candidate="${candidate}.tex"
            ext="tex"
        fi
        if [ "$ext" != "tex" ]; then
            continue
        fi

        local candidate_path="$candidate"
        if [[ "$candidate_path" != /* ]]; then
            candidate_path="$dir/$candidate_path"
        fi

        local resolved
        resolved=$(normalize_path "$candidate_path")
        if [ -z "$resolved" ]; then
            continue
        fi

        if [ -f "$resolved" ]; then
            collect_latex_files "$resolved"
        fi
    done <<EOF
$matches
EOF
}

prepare_project_root() {
    if [ -d "$TARGET_FILE" ]; then
        PROJECT_TYPE="markdown"
        if ! find "$TARGET_FILE" -maxdepth 1 -type f -name "*.md" | grep -q .; then
            local first_section="$TARGET_FILE/1_introduction.md"
            log_warn "No markdown sections found in '$TARGET_FILE'. Creating placeholder '$first_section'."
            printf '# Research Project\n\nGoal: %s\n' "$GOAL" > "$first_section"
        fi
        return 0
    fi

    if [[ "$TARGET_FILE" == *.tex ]]; then
        if [ ! -f "$TARGET_FILE" ]; then
            log_err "LaTeX target '$TARGET_FILE' does not exist."
            exit 1
        fi
        PROJECT_TYPE="latex"
        LATEX_FILES=()
        LATEX_SEEN=""
        LATEX_MAIN=$(normalize_path "$TARGET_FILE")
        collect_latex_files "$LATEX_MAIN"
        if [ "${#LATEX_FILES[@]}" -eq 0 ]; then
            log_warn "No LaTeX files were discovered in '$TARGET_FILE'."
        fi
        return 0
    fi

    PROJECT_TYPE="markdown"
    local base_dir
    base_dir=$(dirname "$TARGET_FILE")
    local base_name
    base_name=$(basename "$TARGET_FILE")
    local name_no_ext
    name_no_ext="${base_name%.*}"
    local project_dir
    project_dir="${base_dir}/${name_no_ext}"

    if [ ! -d "$project_dir" ]; then
        mkdir -p "$project_dir"
        if [ -f "$TARGET_FILE" ]; then
            log_info "Initializing '$project_dir' from '$TARGET_FILE'."
            split_markdown_into_sections "$TARGET_FILE" "$project_dir"
        else
            local first_section="$project_dir/1_introduction.md"
            log_warn "Target '$TARGET_FILE' missing. Creating placeholder '$first_section'."
            printf '# Research Project\n\nGoal: %s\n' "$GOAL" > "$first_section"
        fi
    else
        log_info "Using existing project directory '$project_dir'."
    fi

    TARGET_FILE="$project_dir"
}

apply_prompt_override() {
    local stage="$1"
    local content="$2"
    case "$stage" in
        init) PROMPT_INIT_OVERRIDE="$content" ;;
        expansion) PROMPT_EXPANSION_OVERRIDE="$content" ;;
        mathematize) PROMPT_MATHEMATIZE_OVERRIDE="$content" ;;
        critique) PROMPT_CRITIQUE_OVERRIDE="$content" ;;
        polish) PROMPT_POLISH_OVERRIDE="$content" ;;
        *) log_err "Unknown prompt stage: $stage"; exit 1 ;;
    esac
}

set_prompt_from_pair() {
    local pair="$1"
    if [[ "$pair" != *:* ]]; then
        log_err "Prompt arguments must be in the form '<stage>:<content>'"
        exit 1
    fi
    local stage="${pair%%:*}"
    local content="${pair#*:}"
    stage="$(echo "$stage" | tr '[:upper:]' '[:lower:]')"
    if [ -z "$content" ]; then
        log_err "Prompt for stage '$stage' cannot be empty."
        exit 1
    fi
    apply_prompt_override "$stage" "$content"
}

set_prompt_from_file() {
    local pair="$1"
    if [[ "$pair" != *:* ]]; then
        log_err "Prompt files must be in the form '<stage>:<path>'"
        exit 1
    fi
    local stage="${pair%%:*}"
    local path="${pair#*:}"
    stage="$(echo "$stage" | tr '[:upper:]' '[:lower:]')"
    if [ ! -f "$path" ]; then
        log_err "Prompt file '$path' does not exist."
        exit 1
    fi
    local content
    content=$(cat "$path")
    apply_prompt_override "$stage" "$content"
}

get_prompt_for_stage() {
    local stage="$1"
    case "$stage" in
        init) printf '%s' "${PROMPT_INIT_OVERRIDE:-$PROMPT_INIT}" ;;
        expansion) printf '%s' "${PROMPT_EXPANSION_OVERRIDE:-$PROMPT_EXPANSION}" ;;
        mathematize) printf '%s' "${PROMPT_MATHEMATIZE_OVERRIDE:-$PROMPT_MATHEMATIZE}" ;;
        critique) printf '%s' "${PROMPT_CRITIQUE_OVERRIDE:-$PROMPT_CRITIQUE}" ;;
        polish) printf '%s' "${PROMPT_POLISH_OVERRIDE:-$PROMPT_POLISH}" ;;
        *) log_err "Unsupported stage: $stage"; exit 1 ;;
    esac
}

read_notes_file() {
    if [ -f "$NOTES_FILE" ]; then
        cat "$NOTES_FILE"
    else
        printf ''
    fi
}

build_full_prompt() {
    local stage="$1"
    local stage_prompt
    stage_prompt=$(get_prompt_for_stage "$stage")

    local extra_context=""
    if [ -n "$INSTRUCTION_FILE" ]; then
        extra_context=$(cat "$INSTRUCTION_FILE")
    fi

    local notes_content
    notes_content=$(read_notes_file)
    local notes_instruction=""
    if [ -n "$NOTES_FILE" ]; then
        if [ -f "$NOTES_FILE" ]; then
            notes_instruction="Update '$NOTES_FILE' with concise instructions for the next iteration."
        else
            notes_instruction="Create '$NOTES_FILE' with concise instructions for the next iteration."
        fi
    fi

    local prompt="$SYSTEM_CONTEXT\n\nTARGET FILE: $TARGET_FILE\nPRIMARY GOAL: $GOAL\n"
    if [ -n "$extra_context" ]; then
        prompt+="\nEXTRA CONTEXT:\n$extra_context\n"
    fi
    if [ -n "$notes_content" ]; then
        prompt+="\nPREVIOUS NOTES:\n$notes_content\n"
    fi
    if [ -n "$notes_instruction" ]; then
        prompt+="\n$notes_instruction\n"
    fi
    local layout_desc=""
    if [ "$PROJECT_TYPE" = "latex" ]; then
        layout_desc="PROJECT LAYOUT:\n- Type: LaTeX\n- Main file (resolved): $LATEX_MAIN\n- Included .tex files:"
        for file in "${LATEX_FILES[@]}"; do
            if [ "$file" = "$LATEX_MAIN" ]; then
                layout_desc+="\n  * $file (main)"
            else
                layout_desc+="\n  * $file"
            fi
        done
        layout_desc+="\n- Edit these files directly and keep the include hierarchy intact.\n"
    else
        layout_desc="PROJECT LAYOUT:\n- Type: Markdown\n- Root directory: $TARGET_FILE\n- Each numbered Markdown section file (e.g., 1_introduction.md) is the source of truth; edit them in place.\n"
    fi
    prompt+="$layout_desc\n"
    prompt+="\nCURRENT TASK: $stage_prompt\n"
    printf '%s' "$prompt"
}

run_codex_iteration() {
    local stage="$1"
    local full_prompt
    full_prompt=$(build_full_prompt "$stage")

    if [ "$DRY_RUN" = true ]; then
        log_info "DRY RUN: would execute stage '$stage' with prompt:"
        printf '-----\n%s\n-----\n' "$full_prompt"
        return 0
    fi

    log_info "Running stage '$stage'..."
    local args=("-s" "$SANDBOX_MODE" "exec" "--full-auto")
    if [ -n "$APPROVAL_POLICY" ]; then
        args+=("-a" "$APPROVAL_POLICY")
    fi
    if [ -n "$MODEL_FLAG" ]; then
        args+=("-m" "$MODEL_FLAG")
    fi

    if ! printf '%s' "$full_prompt" | codex "${args[@]}"; then
        log_err "Codex failed for stage '$stage'."
        return 1
    fi
    return 0
}

select_stage_for_iteration() {
    local iteration="$1"
    local total="$2"
    if [ "$iteration" -eq 1 ]; then
        printf 'init'
    elif [ "$iteration" -eq "$total" ]; then
        printf 'polish'
    elif (( iteration % 3 == 0 )); then
        printf 'mathematize'
    elif (( iteration % 4 == 0 )); then
        printf 'critique'
    else
        printf 'expansion'
    fi
}

show_help() {
    cat <<EOF
Codex Researcher (v$VERSION)

Usage: $0 --goal <text> [options]

Required:
  -g, --goal <text>            Research goal (unless --instructions is used)

Options:
  -f, --file <path>            Target Markdown file or directory (default: project.md)
  -i, --instructions <path>    Extra instructions read from a file
  -n, --iterations <num>       Iterations to run (default: 6)
  -d, --delay <seconds>        Delay between iterations (default: 2)
  --notes-file <path>          Shared notes file (default: shared_task_notes.md)
  --model <name>               Model flag passed to codex (e.g., o1)
  -S, --sandbox <mode>         Sandbox policy (read-only, workspace-write, danger-full-access)
  -A, --approval <policy>      Approval policy (untrusted, on-failure, on-request, never)
  --dry-run                    Show prompts but do not call codex
  --prompt <stage>:<text>      Override a stage prompt inline (stage: init|expansion|mathematize|critique|polish)
  --prompt-file <stage>:<path> Override a stage prompt using the contents of a file
  -h, --help                   Show this message
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) show_help; exit 0 ;; 
        -g|--goal)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            GOAL="$2"; shift 2 ;; 
        -f|--file)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            TARGET_FILE="$2"; shift 2 ;; 
        -i|--instructions)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            INSTRUCTION_FILE="$2"; shift 2 ;; 
        -n|--iterations)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            ITERATIONS="$2"; shift 2 ;; 
        -d|--delay)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            DELAY="$2"; shift 2 ;; 
        --notes-file)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            NOTES_FILE="$2"; shift 2 ;; 
        --dry-run)
            DRY_RUN=true; shift ;; 
        --model)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            MODEL_FLAG="$2"; shift 2 ;; 
        -S|--sandbox)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            SANDBOX_MODE="$2"; shift 2 ;; 
        -A|--approval)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            APPROVAL_POLICY="$2"; shift 2 ;; 
        --prompt)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            set_prompt_from_pair "$2"; shift 2 ;; 
        --prompt-file)
            if [[ $# -lt 2 ]]; then log_err "Missing value for $1"; exit 1; fi
            set_prompt_from_file "$2"; shift 2 ;; 
        *)
            log_err "Unknown option: $1"; show_help; exit 1 ;; 
    esac

done

if [ -z "$GOAL" ] && [ -z "$INSTRUCTION_FILE" ]; then
    log_err "You must supply a goal (-g) or an instructions file (-i)."
    show_help
    exit 1
fi

if [ -n "$INSTRUCTION_FILE" ] && [ ! -f "$INSTRUCTION_FILE" ]; then
    log_err "Instruction file '$INSTRUCTION_FILE' not found."
    exit 1
fi

if ! [[ "$ITERATIONS" =~ ^[0-9]+$ ]] || [ "$ITERATIONS" -le 0 ]; then
    log_err "Iterations must be a positive integer."
    exit 1
fi

if ! [[ "$DELAY" =~ ^[0-9]+$ ]] || [ "$DELAY" -lt 0 ]; then
    log_err "Delay must be a non-negative integer."
    exit 1
fi

case "$SANDBOX_MODE" in
    read-only|workspace-write|danger-full-access) ;; 
    *) log_err "Sandbox mode must be read-only, workspace-write, or danger-full-access."; exit 1 ;; 
esac
case "$APPROVAL_POLICY" in
    untrusted|on-failure|on-request|never) ;; 
    *) log_err "Approval policy must be untrusted, on-failure, on-request, or never."; exit 1 ;; 
esac

if ! command -v codex >/dev/null 2>&1; then
    log_err "The 'codex' CLI is required but not installed or not in PATH."
    exit 1
fi

prepare_project_root
log_info "Starting Researcher on '$TARGET_FILE'"

for ((i=1; i<=ITERATIONS; i++)); do
    stage=$(select_stage_for_iteration "$i" "$ITERATIONS")
    log_info "Iteration $i/$ITERATIONS -> stage '$stage'"

    if ! run_codex_iteration "$stage"; then
        log_warn "Stage '$stage' failed. Stopping early."
        break
    fi

    if [ "$i" -lt "$ITERATIONS" ]; then
        sleep "$DELAY"
    fi

done

log_success "Researcher finished. Manuscript is '${TARGET_FILE}'."
