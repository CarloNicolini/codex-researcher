log_info() { echo -e "\033[1;34m[INFO]\033[0m $1"; }
log_success() { echo -e "\033[1;32m[SUCCESS]\033[0m $1"; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
log_err() { echo -e "\033[1;31m[ERROR]\033[0m $1"; }

create_backup() {
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local filename
    filename=$(basename "$TARGET_FILE")
    mkdir -p "$BACKUP_DIR"
    if [ -d "$TARGET_FILE" ]; then
        # Backup the entire project directory
        if ! cp -R "$TARGET_FILE" "$BACKUP_DIR/${filename}_${timestamp}"; then
            log_err "Failed to create directory backup in '$BACKUP_DIR'. Check permissions."
            exit 1
        fi
    else
        if ! cp "$TARGET_FILE" "$BACKUP_DIR/${filename}_${timestamp}.bak"; then
            log_err "Failed to create backup in '$BACKUP_DIR'. Check permissions."
            exit 1
        fi
    fi
}

compute_target_hash() {
    if [ ! -f "$TARGET_FILE" ]; then
        return 1
    fi

    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$TARGET_FILE" 2>/dev/null | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum "$TARGET_FILE" 2>/dev/null | awk '{print $1}'
    elif command -v md5sum >/dev/null 2>&1; then
        md5sum "$TARGET_FILE" 2>/dev/null | awk '{print $1}'
    else
        # Fallback: use file size as a coarse proxy
        wc -c < "$TARGET_FILE" 2>/dev/null | awk '{print "bytes:"$1}'
    fi
}

split_markdown_into_sections() {
    local source_file="$1"
    local dest_dir="$2"

    if [ ! -f "$source_file" ]; then
        return 1
    fi

    mkdir -p "$dest_dir"

    if ! command -v awk >/dev/null 2>&1; then
        # Fallback: single-section file
        cp "$source_file" "$dest_dir/1_section.md"
        return 0
    fi

    awk -v outdir="$dest_dir" '
    function open_section(raw_title) {
        section++
        slug = raw_title
        gsub(/^[#[:space:]]+/, "", slug)
        gsub(/[^A-Za-z0-9]+/, "_", slug)
        gsub(/^_+|_+$/, "", slug)
        if (slug == "") slug = "section"
        filename = sprintf("%s/%d_%s.md", outdir, section, tolower(slug))
        close(current)
        current = filename
        print "" > current
    }
    BEGIN { section = 0; current = "" }
    {
        if ($0 ~ /^# /) {
            open_section($0)
        } else if (section == 0) {
            open_section("section")
        }
        print $0 >> current
    }
    END {
        if (section == 0) {
            current = sprintf("%s/1_section.md", outdir)
            print "" > current
        }
    }
    ' "$source_file"
}

prepare_project_root() {
    # If TARGET_FILE is already a directory, ensure it contains at least one markdown section.
    if [ -d "$TARGET_FILE" ]; then
        if ! find "$TARGET_FILE" -maxdepth 1 -type f -name "*.md" | grep -q .; then
            local first_section="$TARGET_FILE/1_introduction.md"
            log_warn "No markdown sections found in '$TARGET_FILE'. Creating placeholder section '$first_section'..."
            {
                echo "# Research Project"
                echo ""
                echo "Goal: $GOAL"
            } > "$first_section"
        fi
        return 0
    fi

    # Otherwise, treat TARGET_FILE as a single-file entry point and build a multi-file project directory.
    local base_dir
    base_dir=$(dirname "$TARGET_FILE")
    local base_name
    base_name=$(basename "$TARGET_FILE")
    local name_no_ext="${base_name%.*}"
    local project_dir="${base_dir}/${name_no_ext}"

    if [ ! -d "$project_dir" ]; then
        mkdir -p "$project_dir"
        if [ -f "$TARGET_FILE" ]; then
            log_info "Initializing multi-file project directory '$project_dir' from '$TARGET_FILE'."
            split_markdown_into_sections "$TARGET_FILE" "$project_dir"
        else
            local first_section="$project_dir/1_introduction.md"
            log_warn "$TARGET_FILE not found. Creating new project directory '$project_dir' with placeholder section."
            {
                echo "# Research Project"
                echo ""
                echo "Goal: $GOAL"
            } > "$first_section"
        fi
    else
        log_info "Using existing project directory '$project_dir'."
    fi

    TARGET_FILE="$project_dir"
}

parse_duration() {
    # Parse a duration string like "2h", "30m", "1h30m", "90s" into seconds.
    # Returns seconds on stdout, or exits non-zero on error.
    local duration_str="$1"

    # Remove all whitespace
    duration_str=$(echo "$duration_str" | tr -d '[:space:]')

    if [ -z "$duration_str" ]; then
        return 1
    fi

    local total_seconds=0
    local remaining="$duration_str"

    # Hours
    if [[ "$remaining" =~ ([0-9]+)[hH] ]]; then
        local hours="${BASH_REMATCH[1]}"
        total_seconds=$((total_seconds + hours * 3600))
        remaining="${remaining/${BASH_REMATCH[0]}/}"
    fi

    # Minutes
    if [[ "$remaining" =~ ([0-9]+)[mM] ]]; then
        local minutes="${BASH_REMATCH[1]}"
        total_seconds=$((total_seconds + minutes * 60))
        remaining="${remaining/${BASH_REMATCH[0]}/}"
    fi

    # Seconds
    if [[ "$remaining" =~ ([0-9]+)[sS] ]]; then
        local seconds="${BASH_REMATCH[1]}"
        total_seconds=$((total_seconds + seconds))
        remaining="${remaining/${BASH_REMATCH[0]}/}"
    fi

    # Any leftover characters mean invalid format
    if [ -n "$remaining" ]; then
        return 1
    fi

    # Must have parsed something
    if [ "$total_seconds" -eq 0 ]; then
        return 1
    fi

    echo "$total_seconds"
    return 0
}

detect_github_repo() {
    # Try to detect GitHub owner and repo from git remote `origin`
    # Prints "owner repo" on success, returns non-zero on failure.
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        return 1
    fi

    local remote_url
    if ! remote_url=$(git remote get-url origin 2>/dev/null); then
        return 1
    fi

    local owner=""
    local repo=""

    if [[ "$remote_url" =~ ^https://github\.com/([^/]+)/([^/]+)$ ]]; then
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]}"
    elif [[ "$remote_url" =~ ^git@github\.com:([^/]+)/([^/]+)$ ]]; then
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]}"
    else
        return 1
    fi

    repo="${repo%.git}"

    if [ -z "$owner" ] || [ -z "$repo" ]; then
        return 1
    fi

    echo "$owner $repo"
    return 0
}

list_worktrees() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        log_err "Not in a git repository; cannot list worktrees."
        exit 1
    fi

    echo "Active Git Worktrees:"
    echo ""
    if ! git worktree list 2>/dev/null; then
        log_err "Failed to list worktrees."
        exit 1
    fi

    exit 0
}

setup_worktree() {
    if [ -z "$WORKTREE_NAME" ]; then
        # No worktree requested; operate in current working directory.
        return 0
    fi

    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        log_err "Worktrees require a git repository. Run inside a git repo or omit --worktree."
        exit 1
    fi

    local main_repo_dir
    main_repo_dir=$(git rev-parse --show-toplevel)
    local worktree_path="${WORKTREE_BASE_DIR}/${WORKTREE_NAME}"

    if [[ "$worktree_path" != /* ]]; then
        worktree_path="${main_repo_dir}/${worktree_path}"
    fi

    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")

    if [ -d "$worktree_path" ]; then
        log_info "Worktree '$WORKTREE_NAME' already exists at: $worktree_path"
        log_info "Switching to existing worktree directory..."
        if ! cd "$worktree_path"; then
            log_err "Failed to change to worktree directory: $worktree_path"
            exit 1
        fi
        log_info "Pulling latest changes from $current_branch..."
        git pull origin "$current_branch" >/dev/null 2>&1 || log_warn "Failed to pull latest changes (continuing anyway)."
    else
        log_info "Creating worktree '$WORKTREE_NAME' at: $worktree_path"
        local base_dir
        base_dir=$(dirname "$worktree_path")
        if [ ! -d "$base_dir" ]; then
            mkdir -p "$base_dir" || {
                log_err "Failed to create worktree base directory: $base_dir"
                exit 1
            }
        fi
        if ! git worktree add "$worktree_path" "$current_branch" >/dev/null 2>&1; then
            log_err "Failed to create worktree."
            exit 1
        fi
        if ! cd "$worktree_path"; then
            log_err "Failed to change to worktree directory: $worktree_path"
            exit 1
        fi
    fi

    log_success "Worktree '$WORKTREE_NAME' ready at: $worktree_path"
    return 0
}

cleanup_worktree() {
    if [ -z "$WORKTREE_NAME" ] || [ "$CLEANUP_WORKTREE" = false ]; then
        return 0
    fi

    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        return 0
    fi

    local main_repo_dir
    main_repo_dir=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
    local worktree_path="${WORKTREE_BASE_DIR}/${WORKTREE_NAME}"
    if [ -n "$main_repo_dir" ] && [[ "$worktree_path" != /* ]]; then
        worktree_path="${main_repo_dir}/${worktree_path}"
    fi

    echo ""
    log_info "Cleaning up worktree '$WORKTREE_NAME'..."

    # Move to the main repo before removing the worktree
    if [ -n "$main_repo_dir" ]; then
        cd "$main_repo_dir" 2>/dev/null || true
    fi

    if git worktree remove "$worktree_path" --force >/dev/null 2>&1; then
        log_success "Worktree removed successfully."
    else
        log_warn "Failed to remove worktree automatically; you may need to clean up '$worktree_path' manually."
    fi
}

get_iteration_display() {
    local iteration_num="$1"
    local max_iters="$2"
    echo "(${iteration_num}/${max_iters})"
}

create_iteration_branch() {
    local iteration_display="$1"
    local iteration_num="$2"

    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        return 1
    fi

    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")

    if [[ "$current_branch" == ${GIT_BRANCH_PREFIX}* ]]; then
        log_warn "$iteration_display Already on iteration branch: $current_branch"
        if [ -n "$MAIN_BRANCH" ]; then
            git checkout "$MAIN_BRANCH" >/dev/null 2>&1 || return 1
            current_branch="$MAIN_BRANCH"
        fi
    fi

    local date_str
    date_str=$(date +%Y-%m-%d)

    local random_hash
    if command -v openssl >/dev/null 2>&1; then
        random_hash=$(openssl rand -hex 4)
    elif [ -r /dev/urandom ]; then
        random_hash=$(LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 8)
    else
        random_hash=$(printf "%x" $(($(date +%s) % 100000000)))$(printf "%x" $$)
        random_hash=${random_hash:0:8}
    fi

    local branch_name="${GIT_BRANCH_PREFIX}iteration-${iteration_num}/${date_str}-${random_hash}"

    log_info "$iteration_display Creating branch: $branch_name"

    if [ "$DRY_RUN" = true ]; then
        log_info "$iteration_display (DRY RUN) Would create branch $branch_name"
        echo "$branch_name"
        return 0
    fi

    if ! git checkout -b "$branch_name" >/dev/null 2>&1; then
        log_warn "$iteration_display Failed to create branch"
        echo ""
        return 1
    fi

    echo "$branch_name"
    return 0
}

researcher_commit() {
    local iteration_display="$1"
    local branch_name="$2"
    local main_branch="$3"

    if [ -z "$branch_name" ] || [ -z "$main_branch" ]; then
        return 0
    fi

    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        return 0
    fi

    local has_changes=false
    if ! git diff --quiet || ! git diff --cached --quiet; then
        has_changes=true
    fi

    if [ -n "$(git ls-files --others --exclude-standard)" ]; then
        has_changes=true
    fi

    if [ "$has_changes" = false ]; then
        log_info "$iteration_display No git changes detected; cleaning up branch."
        if [ "$DRY_RUN" = true ]; then
            return 0
        fi
        git checkout "$main_branch" >/dev/null 2>&1 || true
        git branch -D "$branch_name" >/dev/null 2>&1 || true
        return 0
    fi

    if [ "$DRY_RUN" = true ]; then
        log_info "$iteration_display (DRY RUN) Would commit and open PR for branch: $branch_name"
        return 0
    fi

    log_info "$iteration_display Committing changes on branch: $branch_name"

    git add . >/dev/null 2>&1 || {
        log_err "$iteration_display Failed to stage changes."
        git checkout "$main_branch" >/dev/null 2>&1 || true
        return 1
    }

    local commit_title="Researcher ${iteration_display} for '$TARGET_FILE'"
    local commit_body="Automated Codex Researcher update for goal: $GOAL

Target file: $TARGET_FILE
"

    if ! git commit -m "$commit_title" -m "$commit_body" >/dev/null 2>&1; then
        log_err "$iteration_display Failed to commit changes."
        git checkout "$main_branch" >/dev/null 2>&1 || true
        return 1
    fi

    log_info "$iteration_display Pushing branch to origin..."
    if ! git push -u origin "$branch_name" >/dev/null 2>&1; then
        log_err "$iteration_display Failed to push branch."
        git checkout "$main_branch" >/dev/null 2>&1 || true
        return 1
    fi

    if [ "$ENABLE_COMMITS" = true ] && command -v gh >/dev/null 2>&1 && [ -n "$GITHUB_OWNER" ] && [ -n "$GITHUB_REPO" ]; then
        log_info "$iteration_display Creating pull request..."
        if ! gh pr create --repo "$GITHUB_OWNER/$GITHUB_REPO" --title "$commit_title" --body "$commit_body" --base "$main_branch" >/dev/null 2>&1; then
            log_warn "$iteration_display Failed to create PR; leaving branch '$branch_name' pushed."
            git checkout "$main_branch" >/dev/null 2>&1 || true
            return 0
        fi

        local merge_flag="--squash"
        case "$MERGE_STRATEGY" in
            merge) merge_flag="--merge" ;;
            rebase) merge_flag="--rebase" ;;
        esac

        log_info "$iteration_display Merging PR for branch '$branch_name' with strategy: $MERGE_STRATEGY"
        if ! gh pr merge "$branch_name" --repo "$GITHUB_OWNER/$GITHUB_REPO" $merge_flag --delete-branch --yes >/dev/null 2>&1; then
            log_warn "$iteration_display Failed to merge PR automatically; it may require manual intervention."
        fi
    fi

    git checkout "$main_branch" >/dev/null 2>&1 || true
    git pull origin "$main_branch" >/dev/null 2>&1 || true

    return 0
}

# ------------------------------------------------------------------------------
# SIGNAL HANDLING (CTRL+C)
