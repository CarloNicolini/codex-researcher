handle_interrupt() {
    echo ""
    log_warn "---------------------------------------------------"
    log_warn "🛑 Process Interrupted by User (Ctrl+C)"
    log_warn "---------------------------------------------------"
    log_info "The pipeline has been stopped."
    
    if [ -d "$BACKUP_DIR" ]; then
        # Find the most recent backup
        local latest_backup=$(ls -t "$BACKUP_DIR" | head -n1)
        if [ -n "$latest_backup" ]; then
            log_info "Latest stable version saved at: $BACKUP_DIR/$latest_backup"
            log_info "If '$TARGET_FILE' is corrupted, restore that backup."
        fi
    fi
    
    exit 130
}

# Trap SIGINT (Ctrl+C)
trap handle_interrupt SIGINT

