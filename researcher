run_codex_iteration() {
    local task_instruction="$1"
    local extra_context=""
    
    # Load instruction file content if provided
    if [ -n "$INSTRUCTION_FILE" ] && [ -f "$INSTRUCTION_FILE" ]; then
        extra_context=$(cat "$INSTRUCTION_FILE")
    fi

    # Construct the Mega-Prompt
    # We explicitly mention the target file again to ensure the agent focuses on it.
    local full_prompt="$SYSTEM_CONTEXT

TARGET FILE: $TARGET_FILE
PRIMARY GOAL: $GOAL
EXTRA CONTEXT: $extra_context

CURRENT TASK: $task_instruction"

    # Replace placeholder in system context with actual project root
    full_prompt="${full_prompt//\{TARGET_FILE\}/$TARGET_FILE}"

    # If the target is a directory, describe the multi-file layout.
    if [ -d "$TARGET_FILE" ]; then
        full_prompt="$full_prompt

PROJECT LAYOUT:
- Root directory: $TARGET_FILE
- Each section is a numbered Markdown file: N_title.md (N = 1, 2, 3, ...).
Guidelines:
- Preserve and refine this multi-file structure.
- When adding new sections, use the next available integer and a short descriptive slug (e.g., 3_related_work.md).
- Keep each file focused on a coherent section.
- When you change content, open and overwrite the appropriate section file(s) on disk so that the project directory stays the single source of truth."
    fi

    # Attach continuous workflow context and shared notes file instructions
    if [ -n "$NOTES_FILE" ]; then
        full_prompt="$full_prompt

## CONTINUOUS WORKFLOW CONTEXT

This is part of a continuous research loop where work happens incrementally across multiple iterations (human and AI). You do not need to complete the entire goal in one run; make solid progress, then leave clear notes for the next iteration.
"

        if [ -f "$NOTES_FILE" ]; then
            local notes_content
            notes_content=$(cat "$NOTES_FILE")
            full_prompt="$full_prompt
## CONTEXT FROM PREVIOUS ITERATION

The following is from $NOTES_FILE, maintained across iterations:

$notes_content
"
        fi

        full_prompt="$full_prompt
## ITERATION NOTES

"

        if [ -f "$NOTES_FILE" ]; then
            full_prompt="$full_prompt Update the \`$NOTES_FILE\` file with relevant context and instructions for the next iteration. Add new notes and remove outdated information so it stays concise and useful."
        else
            full_prompt="$full_prompt Create a \`$NOTES_FILE\` file with relevant context and instructions for the next iteration."
        fi

        full_prompt="$full_prompt

The notes file should:
- Contain relevant context and instructions for the next iteration
- Stay concise and actionable (like a notes file, not a full report)
- Help the next researcher understand what to do next

It should NOT include:
- Exhaustive lists of completed work or full reports
- Information that can be rediscovered by inspecting the manuscript
- Unnecessary implementation details.
"
    fi

    if [ "$DRY_RUN" = true ]; then
        log_info "DRY RUN: Prompt Construction:"
        echo "---------------------------------------------------"
        echo -e "$full_prompt"
        echo "---------------------------------------------------"
        log_info "Command would be: echo \"...\" | codex --full-auto exec"
        return 0
    fi

    log_info "Executing Codex..."

    # -------------------------------------------------------
    # CODEX CLI INVOCATION
    # We pipe the prompt to stdin to avoid argument parsing errors.
    # -------------------------------------------------------
    
    # Build options array: run Codex in a sandboxed, workspace-write mode.
    # We intentionally DO NOT bypass Codex's sandbox or approval mechanisms.
    local GLOBAL_ARGS=("-s" "$SANDBOX_MODE")

    if [ -n "$APPROVAL_POLICY" ]; then
        GLOBAL_ARGS+=("-a" "$APPROVAL_POLICY")
    fi

    if [ -n "$MODEL_FLAG" ]; then
        GLOBAL_ARGS+=("-m" "$MODEL_FLAG")
    fi

    local ARGS=("${GLOBAL_ARGS[@]}" "exec" "--full-auto")

    local exit_code=0

    # When tracking cost, run Codex with JSON output and capture token usage.
    if [ -n "$MAX_COST" ] || [ -n "$PRICE_PER_1K" ]; then
        local tmp_output
        tmp_output=$(mktemp)
        if ! echo "$full_prompt" | codex "${ARGS[@]}" --experimental-json >"$tmp_output"; then
            exit_code=$?
        else
            exit_code=0
        fi

        if [ $exit_code -eq 0 ]; then
            # Extract the latest total_tokens value from token_count events
            local last_total_tokens
            last_total_tokens=$(grep -o '"total_tokens":[0-9]*' "$tmp_output" 2>/dev/null | tail -n1 | sed 's/.*://') || true
            if [ -n "$last_total_tokens" ] && [[ "$last_total_tokens" =~ ^[0-9]+$ ]]; then
                TOTAL_TOKENS=$((TOTAL_TOKENS + last_total_tokens))
                if [ -n "$PRICE_PER_1K" ]; then
                    # Estimate cost for this iteration and accumulate
                    local iter_cost
                    iter_cost=$(awk -v t="$last_total_tokens" -v p="$PRICE_PER_1K" 'BEGIN { printf "%.6f", (t/1000.0)*p }')
                    TOTAL_COST=$(awk -v c="$TOTAL_COST" -v i="$iter_cost" 'BEGIN { printf "%.6f", (c==""?0:c)+i }')
                fi
            fi
        fi

        rm -f "$tmp_output"
    else
        # Run by piping prompt into the command (no JSON capture)
        if ! echo "$full_prompt" | codex "${ARGS[@]}"; then
            exit_code=$?
        else
            exit_code=0
        fi
    fi

    if [ $exit_code -eq 0 ]; then
        return 0
    else
        # If exit code is 130, it was handled by the child process, 
        # but our trap handles the main script logic.
        if [ $exit_code -ne 130 ]; then
            log_err "Codex exited with code $exit_code"
        fi
        return 1
    fi
}

# ------------------------------------------------------------------------------
# ARGUMENT PARSING
# ------------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help) show_help; exit 0 ;;
        -g|--goal)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            GOAL="$2"; shift 2 ;;
        -f|--file)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            TARGET_FILE="$2"; shift 2 ;;
        -i|--instructions)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            INSTRUCTION_FILE="$2"; shift 2 ;;
        -n|--iterations)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            MAX_ITERATIONS="$2"; shift 2 ;;
        -d|--delay)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            ITERATION_DELAY="$2"; shift 2 ;;
        --no-change-threshold)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            NO_CHANGE_THRESHOLD="$2"; shift 2 ;;
        --max-duration)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            MAX_DURATION="$2"; shift 2 ;;
        --max-cost)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            MAX_COST="$2"; shift 2 ;;
        --price-per-1k)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            PRICE_PER_1K="$2"; shift 2 ;;
        --notes-file)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            NOTES_FILE="$2"; shift 2 ;;
        --disable-commits)
            ENABLE_COMMITS=false; shift ;;
        --git-branch-prefix)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            GIT_BRANCH_PREFIX="$2"; shift 2 ;;
        --merge-strategy)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            MERGE_STRATEGY="$2"; shift 2 ;;
        --owner)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            GITHUB_OWNER="$2"; shift 2 ;;
        --repo)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            GITHUB_REPO="$2"; shift 2 ;;
        --worktree)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            WORKTREE_NAME="$2"; shift 2 ;;
        --worktree-base-dir)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            WORKTREE_BASE_DIR="$2"; shift 2 ;;
        --cleanup-worktree)
            CLEANUP_WORKTREE=true; shift ;;
        --list-worktrees)
            LIST_WORKTREES=true; shift ;;
        -m|--model)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            MODEL_FLAG="$2"; shift 2 ;;
        -S|--sandbox)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            SANDBOX_MODE="$2"; shift 2 ;;
        -A|--approval)
            if [[ $# -lt 2 ]]; then
                log_err "Missing value for $1"
                exit 1
            fi
            APPROVAL_POLICY="$2"; shift 2 ;;
        --dry-run) DRY_RUN=true; shift ;;
        *)
            log_err "Unknown option: $1"
            show_help
            exit 1
            ;;
    esac
done

# Validation
if [ -z "$GOAL" ] && [ -z "$INSTRUCTION_FILE" ]; then
    log_err "You must provide a Goal (-g) OR an Instruction File (-i)."
    show_help
    exit 1
fi

if [ -n "$INSTRUCTION_FILE" ] && [ ! -f "$INSTRUCTION_FILE" ]; then
    log_err "Instruction file '$INSTRUCTION_FILE' does not exist."
    exit 1
fi

if ! [[ $MAX_ITERATIONS =~ ^[0-9]+$ ]] || [ "$MAX_ITERATIONS" -le 0 ]; then
    log_err "Iterations must be a positive integer (got '$MAX_ITERATIONS')."
    exit 1
fi

if ! [[ $ITERATION_DELAY =~ ^[0-9]+$ ]] || [ "$ITERATION_DELAY" -lt 0 ]; then
    log_err "Delay must be a non-negative integer (got '$ITERATION_DELAY')."
    exit 1
fi

if ! [[ $NO_CHANGE_THRESHOLD =~ ^[0-9]+$ ]] || [ "$NO_CHANGE_THRESHOLD" -le 0 ]; then
    log_err "No-change threshold must be a positive integer (got '$NO_CHANGE_THRESHOLD')."
    exit 1
fi

if [ -n "$MAX_DURATION" ]; then
    PARSED_DURATION=$(parse_duration "$MAX_DURATION") || {
        log_err "Max duration must be a valid duration (e.g., '2h', '30m', '1h30m', '90s')"
        exit 1
    }
    MAX_DURATION="$PARSED_DURATION"
fi

if [ -n "$MAX_COST" ]; then
    if ! [[ $MAX_COST =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        log_err "Max cost must be a positive number (got '$MAX_COST')."
        exit 1
    fi
fi

if [ -n "$PRICE_PER_1K" ]; then
    if ! [[ $PRICE_PER_1K =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        log_err "Price per 1K tokens must be a positive number (got '$PRICE_PER_1K')."
        exit 1
    fi
fi

if [ -n "$MAX_COST" ] && [ -z "$PRICE_PER_1K" ]; then
    log_err "Using --max-cost requires --price-per-1k to estimate cost from token usage."
    exit 1
fi

case "$SANDBOX_MODE" in
    read-only|workspace-write|danger-full-access) ;;
    *)
        log_err "Sandbox mode must be read-only, workspace-write, or danger-full-access (got '$SANDBOX_MODE')."
        exit 1
        ;;
esac

case "$APPROVAL_POLICY" in
    untrusted|on-failure|on-request|never) ;;
    *)
        log_err "Approval policy must be untrusted, on-failure, on-request, or never (got '$APPROVAL_POLICY')."
        exit 1
        ;;
esac

if [ -n "$MERGE_STRATEGY" ]; then
    if ! [[ "$MERGE_STRATEGY" =~ ^(squash|merge|rebase)$ ]]; then
        log_err "Merge strategy must be one of: squash, merge, rebase (got '$MERGE_STRATEGY')."
        exit 1
    fi
fi

if [ "$ENABLE_COMMITS" = true ]; then
    if ! command -v git >/dev/null 2>&1; then
        log_err "Git is required when commits are enabled."
        exit 1
    fi

    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        log_err "Commits are enabled but this is not a git repository. Run inside a git repo or use --disable-commits."
        exit 1
    fi
fi

if ! command -v codex &> /dev/null; then
    log_err "The 'codex' CLI is not installed or not in your PATH."
    exit 1
fi

if [ -e "$TARGET_FILE" ] && [ ! -w "$TARGET_FILE" ]; then
    log_err "Target file '$TARGET_FILE' is not writable. Check permissions or sandbox settings."
    exit 1
fi

# Optional git worktree handling
if [ "$LIST_WORKTREES" = true ]; then
    list_worktrees
fi

setup_worktree

if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
    MAIN_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
fi

# Ensure worktree cleanup on exit when requested
trap cleanup_worktree EXIT

# ------------------------------------------------------------------------------
# MAIN LOOP
# ------------------------------------------------------------------------------

prepare_project_root
log_info "Starting Researcher on '$TARGET_FILE'"

START_TIME=$(date +%s)
no_change_streak=0

i=1
while [ "$i" -le "$MAX_ITERATIONS" ]; do
    # Global stopping conditions checked at the top of each loop
    if [ -n "$MAX_DURATION" ]; then
        now=$(date +%s)
        elapsed_now=$((now - START_TIME))
        if [ "$elapsed_now" -ge "$MAX_DURATION" ]; then
            log_warn "Max duration reached (${elapsed_now}s); stopping."
            break
        fi
    fi

    if [ -n "$MAX_COST" ] && [ -n "$TOTAL_COST" ]; then
        if awk "BEGIN {exit !($TOTAL_COST >= $MAX_COST)}"; then
            log_warn "Max budget reached (\$$TOTAL_COST / \$$MAX_COST); stopping."
            break
        fi
    fi

    iteration_display=$(get_iteration_display "$i" "$MAX_ITERATIONS")
    branch_name=""

    if [ "$ENABLE_COMMITS" = true ] && command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
        branch_name=$(create_iteration_branch "$iteration_display" "$i" 2>/dev/null || echo "")
    fi

    echo ""
    log_info "--- Iteration $i / $MAX_ITERATIONS ---"

    if [ "$DRY_RUN" = false ]; then
        create_backup
    fi

    # Strategy Selector
    CURRENT_INSTRUCTION=""

    if [ $i -eq 1 ]; then
        CURRENT_INSTRUCTION="$PROMPT_INIT"
    elif [ $i -eq $MAX_ITERATIONS ]; then
        CURRENT_INSTRUCTION="$PROMPT_POLISH"
    elif (( i % 3 == 0 )); then
        CURRENT_INSTRUCTION="$PROMPT_MATHEMATIZE"
    elif (( i % 4 == 0 )); then
        CURRENT_INSTRUCTION="$PROMPT_CRITIQUE"
    else
        CURRENT_INSTRUCTION="$PROMPT_EXPANSION"
    fi

    before_hash=""
    if [ "$DRY_RUN" = false ]; then
        before_hash=$(compute_target_hash || echo "")
    fi

    if run_codex_iteration "$CURRENT_INSTRUCTION"; then
        SUCCESSFUL_ITERATIONS=$((SUCCESSFUL_ITERATIONS + 1))
        ERROR_STREAK=0

        if [ "$DRY_RUN" = false ]; then
            after_hash=$(compute_target_hash || echo "")
            if [ -n "$before_hash" ] && [ -n "$after_hash" ] && [ "$before_hash" = "$after_hash" ]; then
                no_change_streak=$((no_change_streak + 1))
                log_warn "No changes detected in '$TARGET_FILE' (streak: $no_change_streak)."
                if [ "$no_change_streak" -ge "$NO_CHANGE_THRESHOLD" ]; then
                    log_info "No changes in last $NO_CHANGE_THRESHOLD iterations, stopping early."
                    break
                fi
            else
                no_change_streak=0
            fi
        fi

        if [ "$ENABLE_COMMITS" = true ] && [ -n "$branch_name" ] && [ -n "$MAIN_BRANCH" ]; then
            if ! researcher_commit "$iteration_display" "$branch_name" "$MAIN_BRANCH"; then
                log_warn "$iteration_display Git commit/PR step failed; continuing without aborting pipeline."
            fi
        fi

        log_success "Update complete."
    else
        ERROR_STREAK=$((ERROR_STREAK + 1))
        no_change_streak=0
        log_warn "Iteration incomplete (consecutive failures: $ERROR_STREAK)."
        if [ "$ERROR_STREAK" -ge 3 ]; then
            log_err "Aborting after $ERROR_STREAK consecutive Codex failures."
            break
        fi
    fi

    if [ "$DRY_RUN" = false ]; then
        sleep "$ITERATION_DELAY"
    fi

    ((i++))
done

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

echo ""
log_success "Pipeline Finished."
log_info "Successful iterations: $SUCCESSFUL_ITERATIONS (elapsed: ${ELAPSED}s)"
log_info "Final manuscript: $TARGET_FILE"
